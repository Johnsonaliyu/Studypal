# Copy to artifacts/study-pal/.env for local development. NEVER commit the real .env.
# On Railway, set GROQ_API_KEY in the service Variables tab instead.
GROQ_API_KEY=your_groq_key_here
# Optional: override the model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# Local API port used by the Vite dev proxy
PORT=8787
